# Files that run or are read on Linux servers keep LF line endings,
# also in `git archive` (used by gateway/deploy/demo/deploy.sh).
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.pbxproj text eol=lf
*.plist text eol=lf
*.swift text eol=lf
