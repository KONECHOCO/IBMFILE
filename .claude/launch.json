{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gateway",
      "runtimeExecutable": "gateway/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "gateway/run.py"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-storeshots",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "PLEXA_GATEWAY_URL": "https://plexa.ikonetsolutions.com"
      }
    }
  ]
}
