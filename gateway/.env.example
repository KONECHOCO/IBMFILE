# Plexa DB Gateway — all settings are optional.
PLEXA_HOST=127.0.0.1          # 0.0.0.0 to accept connections from other devices
PLEXA_PORT=8787
PLEXA_DATA_DIR=./data         # users, connections (encrypted), audit trail, keys
# PLEXA_ENCRYPTION_KEY=       # Fernet key for stored DB passwords (auto-generated in data/vault.key)
# PLEXA_JWT_SECRET=           # auto-generated in data/jwt.secret
PLEXA_CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
PLEXA_MAX_ROWS=5000
PLEXA_QUERY_TIMEOUT=60
PLEXA_TOKEN_HOURS=12
PLEXA_DEMO=1                  # 0 = no sample SQLite database
# PLEXA_ADMIN_USER=admin      # creates the first admin at start instead of the setup code
# PLEXA_ADMIN_PASSWORD=
# PLEXA_JT400_JAR=./lib/jt400.jar
# PLEXA_WEB_DIST=../dist      # web client served at / when present
